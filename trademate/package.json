{
  "name": "trademate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply trademate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trademate-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.0.0"
  }
}
